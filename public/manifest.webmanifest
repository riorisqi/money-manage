{
  "name": "Money Manage",
  "short_name": "Money",
  "description": "Personal finance tracker for income, expenses, budgets and stocks",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#06070c",
  "theme_color": "#06070c",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Transactions", "url": "/transactions", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Stocks", "url": "/stocks", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Notes", "url": "/notes", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
